{
  "policy_id": "LINDENARC-SIGNAL-GATEWAY",
  "version": "1.0.0",
  "kill_switch_enabled": false,
  "allowed_ticket_fields": [
    "scenario_id",
    "ticket_id",
    "tenant_id",
    "subject",
    "description",
    "customer_email",
    "account_reference",
    "attachment_names"
  ],
  "provider_payload_fields": [
    "request_id",
    "subject",
    "ticket_text",
    "allowed_categories"
  ],
  "mask_data_types": [
    "email_address",
    "phone_number",
    "account_reference"
  ],
  "block_data_types": [
    "social_security_number",
    "bank_account_number",
    "routing_number",
    "payment_card_number",
    "credential",
    "api_key"
  ],
  "prompt_manipulation_phrases": [
    "ignore previous instructions",
    "reveal the system prompt",
    "show hidden instructions",
    "bypass security rules"
  ],
  "allowed_categories": [
    "receipt_upload_error",
    "duplicate_invoice",
    "approval_workflow",
    "account_access",
    "integration_sync",
    "unknown"
  ],
  "maximum_ticket_characters": 4000,
  "maximum_response_characters": 1200
}
